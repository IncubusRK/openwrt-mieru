config mieru 'main'
	option enabled '0'
	option server_addr ''
	option port '2012'
	option protocol 'TCP'
	option username ''
	option password ''
	option profile 'default'
	option socks5_port '1080'
	option socks5_listen_lan '1'
	option http_proxy_port ''
	option http_proxy_listen_lan '0'
	option rpc_port '8964'
	option mtu '1400'
	option multiplexing 'MULTIPLEXING_LOW'
	option handshake_mode 'HANDSHAKE_STANDARD'
	option log_level 'ERROR'
	option traffic_pattern ''

# Additional port bindings (multi-port / ranges).
# The primary binding lives in 'main' (port + protocol); each section below
# adds one more binding, in order. Example:
#
#config port_binding
#	option port '2020-2030'
#	option protocol 'UDP'